---
import Base from './Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
const modes = [
  { href: '/games/up-for-grabs/helper/', label: 'Helper' },
  { href: '/games/up-for-grabs/multiplayer/', label: 'Multiplayer' },
  { href: '/games/up-for-grabs/daily/', label: 'Daily' },
];
---

<Base title={`${title} · Up For Grabs · Daulet Tuleubayev`}>
  <nav class="subnav">
    <a href="/games/up-for-grabs/" aria-current={path === '/games/up-for-grabs/' ? 'page' : undefined}>Up For Grabs</a>
    {modes.map((m) => (
      <a href={m.href} aria-current={path.startsWith(m.href) ? 'page' : undefined}>{m.label}</a>
    ))}
  </nav>
  <slot />
</Base>
