---
import Base from './Base.astro';

interface Props {
  title?: string; // page name; none on the title screen
}

const { title } = Astro.props;
---

<Base title={[title, 'Up For Grabs', 'Daulet Tuleubayev'].filter(Boolean).join(' · ')} wide>
  {title && (
    <nav class="subnav">
      <a href="/games/up-for-grabs/">Up For Grabs</a>
      <a href={Astro.url.pathname} aria-current="page">{title}</a>
    </nav>
  )}
  <slot />
</Base>
